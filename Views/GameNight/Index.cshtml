@using BordspelAvond.Core.Domain
@model IEnumerable<GameNight>

@{
    ViewData["Title"] = "Index";

}

<h1>All Gamenights</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.First().Organizer)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Address)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MaxPlayers)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DateAndTime)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @item.Organizer?.UserName
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Address)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.MaxPlayers)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DateAndTime)
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a>
                    @{
                        var isParticipant = item.Participants.Any(p => p.UserId == ViewBag.CurrentUserId);
                        Console.WriteLine($"GameNight ID: {item.Id}, Is Participant: {isParticipant}"); // Logging toevoegen
                    }
                    @if (item.Participants.Any(p => p.UserId == ViewBag.CurrentUserId))
                    {
                        
                        <!-- Melding als de gebruiker al een participant is -->
                        <button class="btn btn-secondary" onclick="alert('You are already a participant in this GameNight.');">Join</button>
                    }
                    else if (!item.IsSnackRequired)
                    {
                        <!-- Direct joinen als geen snack vereist is -->
                        <a asp-action="Join" asp-route-id="@item.Id" class="btn btn-primary">Join</a>
                    }
                    else
                    {
                        <!-- Naar de details-pagina met Join with Snack-tab -->
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-primary"
                           asp-route-tab="join-with-snack"
                           onclick="alert('You\'ll have to add a snack first!');">Join</a>
                    }
                </td>
            </tr>
        }

    </tbody>
</table>
