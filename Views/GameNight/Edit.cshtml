@model BordspelAvond.Models.GameNight

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>GameNight</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="Address" class="control-label"></label>
                <input asp-for="Address" class="form-control" />
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="MaxPlayers" class="control-label"></label>
                <input asp-for="MaxPlayers" class="form-control" />
                <span asp-validation-for="MaxPlayers" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DateAndTime" class="control-label"></label>
                <input asp-for="DateAndTime" class="form-control" />
                <span asp-validation-for="DateAndTime" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="Is18Plus" class="form-label">Is 18+</label>
                <input asp-for="Is18Plus" class="form-check-input" type="checkbox" />
            </div>
            <div>
                <label asp-for="ProvidesVegetarianOptions" class="form-label">Vegetarian Options</label>
                <input asp-for="ProvidesVegetarianOptions" class="form-check-input" type="checkbox" />
            </div>
            <div>
                <label asp-for="ProvidesLactoseFreeOptions" class="form-label">Lactose Free Options</label>
                <input asp-for="ProvidesLactoseFreeOptions" class="form-check-input" type="checkbox" />
            </div>
            <div>
                <label asp-for="ProvidesNutsFreeOptions" class="form-label">Nut Free Options</label>
                <input asp-for="ProvidesNutsFreeOptions" class="form-check-input" type="checkbox" />
            </div>
            <div>
                <label asp-for="ProvidesAlcoholFreeOptions" class="form-label">Alcohol Free Options</label>
                <input asp-for="ProvidesAlcoholFreeOptions" class="form-check-input" type="checkbox" />
            </div>


            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
