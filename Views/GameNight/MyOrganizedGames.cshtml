@using BordspelAvond.Core.Domain
@model IEnumerable<GameNight>

@{
    ViewData["Title"] = "My Organized GameNights";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <style>
        

        h1 {
            text-align: center;
            font-size: 2.5rem;
            color: #7a5c58;
            margin-bottom: 20px;
        }

        a {
            text-decoration: none;
            color: #7a5c58;
        }

            a:hover {
                color: #ad8b86;
            }

        .btn-primary {
            display: inline-block;
            padding: 10px 20px;
            background-color: #7a5c58;
            color: white;
            border: none;
            border-radius: 5px;
            font-size: 1rem;
            text-decoration: none;
            cursor: pointer;
        }

            .btn-primary:hover {
                background-color: #ad8b86;
            }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
            background-color: #fffdfb;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        th, td {
            padding: 15px;
            text-align: left;
        }

        th {
            background-color: #e7d6cd;
            color: #4b4b4b;
            font-weight: bold;
        }

        td {
            border-bottom: 1px solid #ddd;
        }

            td:last-child {
                text-align: right;
            }

        tr:nth-child(even) {
            background-color: #f9f6f4;
        }

        tr:hover {
            background-color: #f3eae5;
        }

        .create-button {
            display: block;
            margin: 20px auto;
            padding: 10px 20px;
            background-color: #7a5c58;
            color: white;
            border-radius: 5px;
            text-align: center;
            width: fit-content;
        }

            .create-button:hover {
                background-color: #ad8b86;
            }
    </style>
</head>
<body>
    <h1>My Organized GameNights</h1>
    <a asp-action="Create" class="create-button">Create New GameNight</a>
    <table class="table">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.Address)</th>
                <th>@Html.DisplayNameFor(model => model.MaxPlayers)</th>
                <th>@Html.DisplayNameFor(model => model.DateAndTime)</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.Address)</td>
                    <td>@Html.DisplayFor(modelItem => item.MaxPlayers)</td>
                    <td>@Html.DisplayFor(modelItem => item.DateAndTime)</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn-primary">Details</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</body>
</html>
