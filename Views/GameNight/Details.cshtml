@using Microsoft.AspNetCore.Identity
@model GameNight
@inject UserManager<Player> _userManager

@{
    ViewData["Title"] = "GameNight Details";
    var currentUserId = _userManager.GetUserId(User);
    var isOrganizer = Model.OrganizerId == currentUserId;
    var isParticipant = Model.Participants.Any(p => p.UserId == currentUserId);
}

<div class="container my-5">
    <h1 class="text-center mb-4" style="color: #7a5c58;">GameNight Details</h1>
    <div class="card shadow-lg">
        <div class="card-body">
            <ul class="nav nav-tabs mb-4" id="gameNightTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="details-tab" data-bs-toggle="tab" data-bs-target="#details" type="button" role="tab" aria-controls="details" aria-selected="true">Details</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="participants-tab" data-bs-toggle="tab" data-bs-target="#participants" type="button" role="tab" aria-controls="participants" aria-selected="false">Participants</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="games-tab" data-bs-toggle="tab" data-bs-target="#games" type="button" role="tab" aria-controls="games" aria-selected="false">Games</button>
                </li>
                @if (Model.IsSnackRequired)
                {
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="snacks-tab" data-bs-toggle="tab" data-bs-target="#snacks" type="button" role="tab" aria-controls="snacks" aria-selected="false">Snacks</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="join-with-snack-tab" data-bs-toggle="tab" data-bs-target="#join-with-snack" type="button" role="tab" aria-controls="join-with-snack" aria-selected="false">Join with Snack</button>
                    </li>
                }
                @if (isOrganizer)
                {
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="manage-tab" data-bs-toggle="tab" data-bs-target="#manage" type="button" role="tab" aria-controls="manage" aria-selected="false">Manage</button>
                    </li>
                }
            </ul>

            <div class="tab-content" id="gameNightTabsContent">
                <!-- Details Tab -->
                <div class="tab-pane fade show active" id="details" role="tabpanel" aria-labelledby="details-tab">
                    <h4 class="mb-3" style="color: #7a5c58;">Details</h4>
                    <dl class="row">
                        <dt class="col-sm-4">Organizer</dt>
                        <dd class="col-sm-8">@Model.Organizer.UserName</dd>

                        <dt class="col-sm-4">Address</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.Address)</dd>

                        <dt class="col-sm-4">Max Players</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.MaxPlayers)</dd>

                        <dt class="col-sm-4">Date and Time</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.DateAndTime)</dd>

                        <dt class="col-sm-4">Age Requirement</dt>
                        <dd class="col-sm-8">
                            <span class="badge @(Model.Is18Plus ? "bg-danger" : "bg-success")">
                                @(Model.Is18Plus ? "18+" : "All Ages")
                            </span>
                        </dd>

                        <dt class="col-sm-4">Available Food & Drink Options</dt>
                        <dd class="col-sm-8">
                            @{
                                bool hasVegetarian = Model.ProvidesVegetarianOptions || Model.Snacks.Any(s => s.IsVegetarian);
                                bool hasLactoseFree = Model.ProvidesLactoseFreeOptions || Model.Snacks.Any(s => s.IsLactoseFree);
                                bool hasNutFree = Model.ProvidesNutsFreeOptions || Model.Snacks.Any(s => s.IsNutFree);
                                bool hasAlcoholFree = Model.ProvidesAlcoholFreeOptions || Model.Snacks.Any(s => s.IsAlcoholFree);
                            }

                            @if (hasVegetarian || hasLactoseFree || hasNutFree || hasAlcoholFree)
                            {
                                <ul>
                                    @if (hasVegetarian)
                                    {
                                        <li>Vegetarian</li>
                                    }
                                    @if (hasLactoseFree)
                                    {
                                        <li>Lactose-Free</li>
                                    }
                                    @if (hasNutFree)
                                    {
                                        <li>Nut-Free</li>
                                    }
                                    @if (hasAlcoholFree)
                                    {
                                        <li>Alcohol-Free</li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <p>No specific dietary options available.</p>
                            }
                        </dd>

                    </dl>
                </div>

                <!-- Participants Tab -->
                <div class="tab-pane fade" id="participants" role="tabpanel" aria-labelledby="participants-tab">
                    <h4 class="mb-3" style="color: #7a5c58;">Participants</h4>
                    @if (Model.Participants != null && Model.Participants.Any())
                    {
                        <ul>
                            @foreach (var participant in Model.Participants)
                            {
                                var user = await _userManager.FindByIdAsync(participant.UserId);
                                <li>@user?.UserName</li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p>No participants yet.</p>
                    }
                </div>

                <!-- Games Tab -->
                <div class="tab-pane fade" id="games" role="tabpanel" aria-labelledby="games-tab">
                    <h4 class="mb-3" style="color: #7a5c58;">Games</h4>
                    @if (isOrganizer)
                    {
                        <form asp-action="AddGameToGameNight" method="post">
                            <input type="hidden" name="gameNightId" value="@Model.Id" />
                            <select name="gameId" class="form-select">
                                @foreach (var game in ViewBag.AvailableGames)
                                {
                                    <option value="@game.Id">@game.Name</option>
                                }
                            </select>
                            <button type="submit" class="btn btn-primary mt-2">Add Game</button>
                        </form>
                    }
                    <ul>
                        @foreach (var gameNightGame in Model.GameNightGames)
                        {
                            <li>
                                @gameNightGame.Game.Name
                                <a asp-controller="Game" asp-action="Details" asp-route-id="@gameNightGame.Game.Id" class="btn btn-sm btn-info">Details</a>
                            </li>
                        }
                    </ul>
                </div>

                <!-- Snacks Tab -->
                @if (Model.IsSnackRequired)
                {
                    <div class="tab-pane fade" id="snacks" role="tabpanel" aria-labelledby="snacks-tab">
                        <h4 class="mb-3" style="color: #7a5c58;">Snacks</h4>
                        <ul class="list-group">
                            @foreach (var snack in Model.Snacks)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <span>@snack.SnackName</span>
                                    <div>
                                        @if (snack.IsVegetarian)
                                        {
                                            <span class="badge bg-success me-1">Vegetarian</span>
                                        }
                                        @if (snack.IsLactoseFree)
                                        {
                                            <span class="badge bg-info me-1">Lactose-Free</span>
                                        }
                                        @if (snack.IsNutFree)
                                        {
                                            <span class="badge bg-warning me-1">Nut-Free</span>
                                        }
                                        @if (snack.IsAlcoholFree)
                                        {
                                            <span class="badge bg-secondary me-1">Alcohol-Free</span>
                                        }
                                    </div>
                                </li>
                            }
                        </ul>
                    </div>
                }

                <!-- Join with Snack Tab -->
                @if (Model.IsSnackRequired)
                {
                    <div class="tab-pane fade" id="join-with-snack" role="tabpanel" aria-labelledby="join-with-snack-tab">
                        <div class="card mt-4">
                            <div class="card-body">
                                <h4 class="card-title">Join with a Snack</h4>
                                <form asp-action="JoinWithSnack" method="post">
                                    <input type="hidden" name="gameNightId" value="@Model.Id" />
                                    <div class="form-group mb-3">
                                        <label for="snackName">Snack Name</label>
                                        <input type="text" class="form-control" id="snackName" name="snackName" required />
                                    </div>
                                    <div class="form-check mb-2">
                                        <input class="form-check-input" type="checkbox" id="isVegetarian" name="isVegetarian" value="true" />
                                        <label class="form-check-label" for="isVegetarian">Vegetarian</label>
                                    </div>
                                    <div class="form-check mb-2">
                                        <input class="form-check-input" type="checkbox" id="isLactoseFree" name="isLactoseFree" value="true" />
                                        <label class="form-check-label" for="isLactoseFree">Lactose-Free</label>
                                    </div>
                                    <div class="form-check mb-2">
                                        <input class="form-check-input" type="checkbox" id="isNutFree" name="isNutFree" value="true" />
                                        <label class="form-check-label" for="isNutFree">Nut-Free</label>
                                    </div>
                                    <div class="form-check mb-2">
                                        <input class="form-check-input" type="checkbox" id="isAlcoholFree" name="isAlcoholFree" value="true" />
                                        <label class="form-check-label" for="isAlcoholFree">Alcohol-Free</label>
                                    </div>
                                    <button type="submit" class="btn btn-primary">Join GameNight and Add Snack</button>
                                </form>
                            </div>
                        </div>
                    </div>
                }

                <!-- Manage Tab -->
                @if (isOrganizer)
                {
                    <div class="tab-pane fade" id="manage" role="tabpanel" aria-labelledby="manage-tab">
                        <h4 class="mb-3" style="color: #7a5c58;">Manage GameNight</h4>
                        @if (!Model.Participants.Any())
                        {
                            <div class="d-flex gap-2">
                                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this GameNight?');">
                                    <button type="submit" class="btn btn-danger btn-lg">
                                        <i class="fas fa-trash-alt"></i> Delete
                                    </button>
                                </form>
                                <form asp-action="Edit" asp-route-id="@Model.Id" method="get">
                                    <button type="submit" class="btn btn-primary btn-lg">
                                        <i class="fas fa-edit"></i> Edit
                                    </button>
                                </form>
                            </div>
                        }
                        else
                        {
                            <p class="text-danger">You cannot delete this GameNight as it has participants.</p>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
