@using Microsoft.AspNetCore.Identity
@model BordspelAvond.Models.GameNight
@inject UserManager<BordspelAvond.Models.Player> _userManager

@{
    ViewData["Title"] = "GameNight Details";
}

<h1>GameNight Details</h1>

<div>
    <h4>GameNight</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Organizer
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.OrganizerId)
        </dd>
        <dt class="col-sm-2">
            Address
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Address)
        </dd>
        <dt class="col-sm-2">
            Max Players
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.MaxPlayers)
        </dd>
        <dt class="col-sm-2">
            Date and Time
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DateAndTime)
        </dd>
    </dl>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary">Edit</a> |
    <a asp-action="Index" class="btn btn-secondary">Back to List</a> |
    <a asp-action="Join" asp-route-id="@Model?.Id" class="btn btn-success">Join this GameNight</a>
</div>

<h3>Participants</h3>
@if (Model.Participants != null && Model.Participants.Any())
{
    <ul>
        @foreach (var participant in Model.Participants)
        {
            var user = await _userManager.FindByIdAsync(participant.UserId);
            <li>@user?.UserName</li> <!-- Toont de gebruikersnaam van de deelnemer -->
        }
    </ul>
}
else
{
    <p>No participants yet.</p>
}
