@using Microsoft.AspNetCore.Identity
@model BordspelAvond.Models.GameNight
@inject UserManager<BordspelAvond.Models.Player> _userManager

@{
    ViewData["Title"] = "GameNight Details";
    var currentUserId = _userManager.GetUserId(User); // Huidige gebruiker ophalen
    var isOrganizer = Model.OrganizerId == currentUserId; // Controleren of huidige gebruiker de organisator is
}

<h1>GameNight Details</h1>

<div>
    <h4>GameNight</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Organizer
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.OrganizerId)
        </dd>
        <dt class="col-sm-2">
            Address
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Address)
        </dd>
        <dt class="col-sm-2">
            Max Players
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.MaxPlayers)
        </dd>
        <dt class="col-sm-2">
            Date and Time
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DateAndTime)
        </dd>
        <dt class="col-sm-2">
            Age Requirement
        </dt>
        <dd class="col-sm-10">
            @if (Model.Is18Plus)
            {
                <span class="badge bg-danger">18+</span>
            }
            else
            {
                <span class="badge bg-success">All Ages</span>
            }
        </dd>
    </dl>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary">Edit</a> |
    <a asp-action="Index" class="btn btn-secondary">Back to List</a> |
    <a asp-action="Join" asp-route-id="@Model?.Id" class="btn btn-success">Join this GameNight</a>
</div>

<h3>Participants</h3>
@if (Model.Participants != null && Model.Participants.Any())
{
    <ul>
        @foreach (var participant in Model.Participants)
        {
            var user = await _userManager.FindByIdAsync(participant.UserId);
            <li>@user?.UserName</li> <!-- Toont de gebruikersnaam van de deelnemer -->
        }
    </ul>
}
else
{
    <p>No participants yet.</p>
}

@if (isOrganizer && !Model.Participants.Any())
{
    <!-- Delete button is alleen zichtbaar voor de organisator en wanneer er geen deelnemers zijn -->
    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this game night?');">
        <button type="submit" class="btn btn-danger">Delete</button>
    </form>
}
else if (isOrganizer)
{
    <p>You cannot delete this Game Night because there are participants.</p>
}

@section Scripts {
    <script>
        // Controleer op foutmelding en toon een alert-popup
        @if (TempData["JoinError"] != null)
        {
            <text>
                    alert("@TempData["JoinError"]");
            </text>
        }
    </script>
}
