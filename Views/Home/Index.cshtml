@{
    ViewData["Title"] = "Home Page";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <style>
        body {
            font-family: 'Arial', sans-serif;
            background-color: #f5f3ef;
            color: #4b4b4b;
            margin: 0;
            padding: 20px;
        }

        h1 {
            text-align: center;
            font-size: 2.5rem;
            color: #7a5c58;
            margin-bottom: 10px;
        }

        h2 {
            text-align: center;
            font-size: 1.8rem;
            color: #4b4b4b;
            margin-top: 30px;
        }

        p {
            text-align: center;
            color: #4b4b4b;
            line-height: 1.6;
            font-size: 1.1rem;
        }

        .hero-section {
            background-color: #fffdfb;
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            text-align: center;
            margin: 20px auto;
            width: 80%;
        }

        .btn-primary {
            display: inline-block;
            padding: 10px 20px;
            background-color: #7a5c58;
            color: white;
            border: none;
            border-radius: 5px;
            font-size: 1rem;
            text-decoration: none;
            cursor: pointer;
            margin: 10px;
        }

            .btn-primary:hover {
                background-color: #ad8b86;
            }

        .features-section {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            margin-top: 30px;
        }

        .feature {
            background-color: #fffdfb;
            margin: 10px;
            padding: 20px;
            border-radius: 10px;
            width: 250px;
            text-align: center;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

            .feature h3 {
                color: #7a5c58;
                font-size: 1.5rem;
                margin-bottom: 10px;
            }

            .feature p {
                color: #4b4b4b;
                font-size: 1rem;
            }
    </style>
</head>
<body>
    <div class="hero-section">
        <h1>Welkom bij Bordspel Avond!</h1>
        <p>Ontdek nieuwe connecties, speel spannende bordspellen, en beleef onvergetelijke avonden met vrienden en familie!</p>
        <a href="/GameNight/Index" class="btn-primary">Bekijk GameNights</a>
        <a href="Identity/Account/Register" class="btn-primary">Word Lid</a>
    </div>

    <h2>Waarom Bordspel Avond?</h2>
    <div class="features-section">
        <div class="feature">
            <h3>Sociale Connecties</h3>
            <p>Maak nieuwe vrienden en versterk relaties door samen te spelen.</p>
        </div>
        <div class="feature">
            <h3>Diversiteit aan Spellen</h3>
            <p>Kies uit een breed scala aan bordspellen, van klassiekers tot moderne hits.</p>
        </div>
        <div class="feature">
            <h3>Toegankelijkheid</h3>
            <p>Onze evenementen zijn open voor iedereen, van beginners tot experts.</p>
        </div>
        <div class="feature">
            <h3>Snacks en Meer</h3>
            <p>Geniet van een gezellige sfeer met hapjes en drankjes afgestemd op jouw wensen.</p>
        </div>
    </div>
</body>
</html>
